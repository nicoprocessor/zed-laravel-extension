    ],
    "description": "Blade @push block"
  },
  "b:pushOnce": {
    "prefix": "b:pushOnce",
    "body": [
      "@pushOnce('${1:scripts}')",
      "\t$0",
      "@endPushOnce"
    ],
    "description": "Blade @pushOnce block"
  },
  "b:stack": {
    "prefix": "b:stack",
    "body": [
      "@stack('${1:scripts}')"
    ],
    "description": "Blade @stack directive"
  },
  "b:once": {
    "prefix": "b:once",
