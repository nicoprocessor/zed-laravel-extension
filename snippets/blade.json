    ],
    "description": "Blade @method directive for form spoofing"
  },
  "b:error": {
    "prefix": "b:error",
    "body": [
      "@error('${1:field}')",
      "\t<p class=\"text-red-500\">{{ \\$message }}</p>",
      "@enderror"
    ],
    "description": "Blade @error block"
  },
  "b:session": {
    "prefix": "b:session",
    "body": [
