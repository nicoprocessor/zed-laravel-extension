      "@endguest"
    ],
    "description": "Blade @guest block"
  },
  "b:can": {
    "prefix": "b:can",
    "body": [
      "@can('${1:ability}', ${2:\\$model})",
      "\t$0",
      "@endcan"
    ],
    "description": "Blade @can authorization block"
  },
  "b:cannot": {
    "prefix": "b:cannot",
    "body": [
      "@cannot('${1:ability}', ${2:\\$model})",
      "\t$0",
      "@endcannot"
    ],
