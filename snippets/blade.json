    ],
    "description": "Blade comment {{-- --}}"
  },
  "b:old": {
    "prefix": "b:old",
    "body": [
      "{{ old('${1:field}'${2:, ${3:\\$default}}) }}"
    ],
    "description": "Blade old() form helper"
  },
  "b:asset": {
    "prefix": "b:asset",
    "body": [
