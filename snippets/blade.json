    ],
    "description": "Blade @yield directive"
  },
  "b:include": {
    "prefix": "b:include",
    "body": [
      "@include('${1:view.name}')"
    ],
    "description": "Blade @include directive"
  },
  "b:includeIf": {
    "prefix": "b:includeIf",
    "body": [
      "@includeIf('${1:view.name}')"
    ],
    "description": "Blade @includeIf directive"
  },
  "b:includeWhen": {
    "prefix": "b:includeWhen",
    "body": [
      "@includeWhen(${1:condition}, '${2:view.name}')"
    ],
    "description": "Blade @includeWhen directive"
  },
  "b:includeUnless": {
    "prefix": "b:includeUnless",
    "body": [
      "@includeUnless(${1:condition}, '${2:view.name}')"
    ],
    "description": "Blade @includeUnless directive"
  },
  "b:includeFirst": {
    "prefix": "b:includeFirst",
    "body": [
      "@includeFirst(['${1:view.name}', '${2:fallback.view}'])"
    ],
    "description": "Blade @includeFirst directive"
  },
  "b:each": {
    "prefix": "b:each",
    "body": [
      "@each('${1:view.name}', ${2:\\$items}, '${3:item}')"
    ],
    "description": "Blade @each directive"
  },
  "b:component": {
    "prefix": "b:component",
    "body": [
      "<x-${1:component} ${2:}/>$0"
    ],
    "description": "Blade <x-component /> self-closing tag"
  },
  "b:component:block": {
    "prefix": "b:component:block",
    "body": [
      "<x-${1:component} ${2:}>",
      "\t$0",
      "</x-${1:component}>"
    ],
    "description": "Blade <x-component> block tag"
  },
  "b:slot": {
    "prefix": "b:slot",
    "body": [
      "<x-slot:${1:name}>",
      "\t$0",
      "</x-slot>"
    ],
    "description": "Blade <x-slot:name> block"
  },
  "b:props": {
    "prefix": "b:props",
    "body": [
      "@props([",
      "\t'${1:name}' => ${2:'default'},",
      "])"
    ],
    "description": "Blade @props directive"
  },
  "b:auth": {
    "prefix": "b:auth",
    "body": [
      "@auth${1:('${2:guard}')}",
      "\t$0",
      "@endauth"
    ],
    "description": "Blade @auth block"
  },
  "b:guest": {
    "prefix": "b:guest",
    "body": [
      "@guest${1:('${2:guard}')}",
