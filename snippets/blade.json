{
  "b:if": {
    "prefix": "b:if",
    "body": [
      "@if (${1:condition})",
      "\t$0",
      "@endif"
    ],
    "description": "Blade @if block"
  },
  "b:ifelse": {
    "prefix": "b:ifelse",
    "body": [
      "@if (${1:condition})",
      "\t$2",
      "@else",
      "\t$0",
      "@endif"
    ],
    "description": "Blade @if / @else block"
  },
  "b:ifelseif": {
    "prefix": "b:ifelseif",
    "body": [
      "@if (${1:condition})",
      "\t$2",
      "@elseif (${3:condition})",
      "\t$4",
      "@else",
      "\t$0",
      "@endif"
    ],
    "description": "Blade @if / @elseif / @else block"
  },
  "b:unless": {
    "prefix": "b:unless",
    "body": [
      "@unless (${1:condition})",
      "\t$0",
      "@endunless"
    ],
    "description": "Blade @unless block"
  },
  "b:isset": {
    "prefix": "b:isset",
    "body": [
      "@isset (${1:\\$variable})",
      "\t$0",
      "@endisset"
    ],
    "description": "Blade @isset block"
  },
  "b:empty": {
    "prefix": "b:empty",
    "body": [
      "@empty (${1:\\$variable})",
      "\t$0",
      "@endempty"
    ],
    "description": "Blade @empty block"
  },
  "b:foreach": {
    "prefix": "b:foreach",
    "body": [
      "@foreach (${1:\\$items} as ${2:\\$item})",
      "\t$0",
      "@endforeach"
    ],
    "description": "Blade @foreach loop"
  },
  "b:forelse": {
    "prefix": "b:forelse",
    "body": [
      "@forelse (${1:\\$items} as ${2:\\$item})",
      "\t$3",
      "@empty",
      "\t$0",
      "@endforelse"
    ],
    "description": "Blade @forelse loop with @empty fallback"
  },
  "b:for": {
    "prefix": "b:for",
    "body": [
      "@for (${1:\\$i = 0}; ${2:\\$i < count}; ${3:\\$i++})",
      "\t$0",
      "@endfor"
    ],
    "description": "Blade @for loop"
  },
  "b:while": {
    "prefix": "b:while",
    "body": [
      "@while (${1:condition})",
      "\t$0",
      "@endwhile"
    ],
    "description": "Blade @while loop"
  },
  "b:switch": {
    "prefix": "b:switch",
    "body": [
      "@switch(${1:\\$variable})",
      "\t@case(${2:value})",
      "\t\t$3",
      "\t\t@break",
      "",
      "\t@default",
      "\t\t$0",
      "@endswitch"
    ],
    "description": "Blade @switch block"
  },
  "b:extends": {
    "prefix": "b:extends",
    "body": [
      "@extends('${1:layouts.app}')"
    ],
    "description": "Blade @extends directive"
  },
  "b:section": {
    "prefix": "b:section",
    "body": [
      "@section('${1:content}')",
      "\t$0",
      "@endsection"
    ],
    "description": "Blade @section block"
  },
  "b:section:inline": {
    "prefix": "b:section:inline",
    "body": [
      "@section('${1:title}', '${2:value}')"
    ],
    "description": "Blade inline @section directive"
  },
  "b:yield": {
    "prefix": "b:yield",
    "body": [
