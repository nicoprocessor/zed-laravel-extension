    ],
    "description": "Livewire component block tag"
  },
  "lw:directive": {
    "prefix": "lw:directive",
    "body": [
      "@livewire('${1:component-name}'${2:, ['${3:key}' => ${4:\\$value}]})"
    ],
    "description": "@livewire() Blade directive"
  },
  "lw:persist": {
    "prefix": "lw:persist",
