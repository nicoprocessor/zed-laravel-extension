{
  "lw:component": {
    "prefix": "lw:component",
    "body": [
      "<?php",
      "",
      "namespace App\\Livewire;",
      "",
      "use Livewire\\Component;",
      "",
      "class ${1:Name} extends Component",
      "{",
      "\t$2",
      "",
      "\tpublic function render()",
      "\t{",
      "\t\treturn view('livewire.${3:name}');",
      "\t}",
      "}"
    ],
    "description": "Livewire 3 component class"
  },
  "lw:component:full": {
    "prefix": "lw:component:full",
    "body": [
      "<?php",
      "",
      "namespace App\\Livewire;",
      "",
      "use Livewire\\Attributes\\Layout;",
      "use Livewire\\Component;",
      "",
      "#[Layout('${1:layouts.app}')]",
      "class ${2:Name} extends Component",
      "{",
      "\t$3",
      "",
      "\tpublic function mount(${4:}): void",
      "\t{",
      "\t\t$5",
      "\t}",
      "",
      "\tpublic function render()",
      "\t{",
      "\t\treturn view('livewire.${6:name}');",
      "\t}",
      "}"
    ],
    "description": "Livewire 3 full-page component class"
  },
  "lw:property": {
    "prefix": "lw:property",
    "body": [
      "public ${1|string,int,bool,array|} \\$${2:name}${3: = ${4:''}};"
    ],
    "description": "Livewire 3 public property"
  },
  "lw:property:validated": {
    "prefix": "lw:property:validated",
    "body": [
      "#[Validate('${1|required,nullable|}${2:|string,integer,email,min:3,max:255|}')]",
      "public ${3|string,int,bool,array|} \\$${4:name}${5: = ${6:''}};"
    ],
    "description": "Livewire 3 validated property"
  },
  "lw:mount": {
    "prefix": "lw:mount",
    "body": [
      "public function mount(${1:}): void",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Livewire 3 mount lifecycle hook"
  },
  "lw:action": {
    "prefix": "lw:action",
    "body": [
      "public function ${1:actionName}(${2:}): void",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Livewire 3 action method"
  },
  "lw:computed": {
    "prefix": "lw:computed",
    "body": [
      "#[Computed]",
      "public function ${1:name}(): ${2:mixed}",
      "{",
      "\treturn $0;",
      "}"
    ],
    "description": "Livewire 3 computed property"
  },
  "lw:form": {
    "prefix": "lw:form",
    "body": [
      "<?php",
      "",
      "namespace App\\Livewire\\Forms;",
      "",
      "use Livewire\\Attributes\\Validate;",
      "use Livewire\\Form;",
      "",
      "class ${1:Name}Form extends Form",
      "{",
      "\t#[Validate('required')]",
      "\tpublic string \\$${2:field} = '';",
      "",
      "\t$0",
      "}"
    ],
    "description": "Livewire 3 form object class"
  },
  "lw:dispatch": {
    "prefix": "lw:dispatch",
    "body": [
      "\\$this->dispatch('${1:event-name}'${2:, ${3:param}: \\$${4:value}});"
    ],
    "description": "Livewire 3 dispatch event"
  },
  "lw:on": {
    "prefix": "lw:on",
    "body": [
      "#[On('${1:event-name}')]",
      "public function ${2:handleEvent}(${3:}): void",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Livewire 3 event listener"
  },
  "lw:updated": {
    "prefix": "lw:updated",
    "body": [
      "public function updated${1:PropertyName}(\\$value): void",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Livewire 3 updated lifecycle hook"
  },
  "lw:updating": {
    "prefix": "lw:updating",
    "body": [
      "public function updating${1:PropertyName}(\\$value): void",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Livewire 3 updating lifecycle hook"
  },
  "lw:pagination": {
    "prefix": "lw:pagination",
    "body": [
      "use Livewire\\WithPagination;",
      "",
      "// Inside class:",
      "use WithPagination;"
    ],
    "description": "Livewire 3 pagination trait"
  },
  "lw:fileUpload": {
    "prefix": "lw:fileUpload",
    "body": [
      "use Livewire\\WithFileUploads;",
      "",
      "// Inside class:",
      "use WithFileUploads;",
      "",
      "#[Validate('${1|image,file|}|max:${2:1024}')]",
      "public \\$${3:photo};"
    ],
    "description": "Livewire 3 file upload setup"
  },
  "lw:lazy": {
    "prefix": "lw:lazy",
    "body": [
