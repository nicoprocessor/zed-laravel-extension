      "public ${1|string,int,bool|} \\$${2:id};"
    ],
    "description": "Livewire 3 #[Locked] property"
  },
  "lw:url": {
    "prefix": "lw:url",
    "body": [
      "#[Url]",
      "public ${1|string,int,bool|} \\$${2:search} = '${3:}';"
    ],
