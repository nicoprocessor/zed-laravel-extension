  },
  "lw:tag": {
    "prefix": "lw:tag",
    "body": [
      "<livewire:${1:component-name} ${2:}/>$0"
    ],
    "description": "Livewire component tag"
  },
  "lw:tag:block": {
    "prefix": "lw:tag:block",
    "body": [
      "<livewire:${1:component-name} ${2:}>",
      "\t$0",
