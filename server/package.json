{
  "name": "laravel-lsp-server",
  "version": "0.0.1",
  "description": "Laravel Language Server for Zed editor",
  "main": "dist/server.js",
  "author": "Harris Raftopoulos",
  "repository": {
    "type": "git",
    "url": "https://github.com/harris21/zed-laravel-extension.git",
    "directory": "server"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "esbuild": "^0.21.0",
    "@types/node": "^20.0.0"
  },
  "license": "MIT"
}
